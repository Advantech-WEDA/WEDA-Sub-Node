<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageId>Weda.SubNode.Templates</PackageId>
    <Title>Weda SubNode Project Templates</Title>
    <Authors>Advantech</Authors>
    <Description>Templates for creating Weda SubNode applications</Description>
    <PackageTags>dotnet-new;templates;weda;subnode;iot</PackageTags>
    <TargetFramework>net9.0</TargetFramework>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="subnode\**\*" Exclude="subnode\**\bin\**;subnode\**\obj\**" />
    <Content Include="wedaapi\**\*" Exclude="wedaapi\**\bin\**;wedaapi\**\obj\**" />
    <Content Include="wedaapi-c\**\*" Exclude="wedaapi-c\**\bin\**;wedaapi-c\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
