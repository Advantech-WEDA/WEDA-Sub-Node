{
  "@context": [
    "dtmi:dtdl:context;3",
    "dtmi:advantech:edgesync:validation;1"
  ],
  "@id": "dtmi:advantech:weda:transform:calibration;1",
  "@type": "Interface",
  "displayName": "calibration",
  "description": "Apply linear (Scale \u002B Offset) or curve-based calibration to numeric measurements.",
  "schemas": [
    {
      "@id": "dtmi:advantech:weda:transform:calibration:CalibrationPoint;1",
      "@type": "Object",
      "fields": [
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "rawValue",
          "description": "Raw sensor value before calibration.",
          "schema": "double",
          "required": false,
          "writable": true
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "calibratedValue",
          "description": "Calibrated sensor value after calibration.",
          "schema": "double",
          "required": false,
          "writable": true
        }
      ]
    },
    {
      "@id": "dtmi:advantech:weda:transform:calibration:calibrationCurveCalibrationPointList;1",
      "@type": "Array",
      "elementSchema": "dtmi:advantech:weda:transform:calibration:CalibrationPoint;1"
    },
    {
      "@id": "dtmi:advantech:weda:transform:calibration:parameters;1",
      "@type": "Object",
      "fields": [
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "scale",
          "description": "Linear calibration scale factor. Must not be zero.",
          "schema": "double",
          "required": false,
          "writable": true,
          "default": 1
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "offset",
          "description": "Linear calibration offset value.",
          "schema": "double",
          "required": false,
          "writable": true,
          "default": 0
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "calibrationCurve",
          "description": "Curve points for non-linear calibration. Overrides Scale/Offset when provided.",
          "schema": "dtmi:advantech:weda:transform:calibration:calibrationCurveCalibrationPointList;1",
          "required": false,
          "writable": true
        }
      ]
    }
  ],
  "contents": [
    {
      "@type": [
        "Property",
        "ConfigConstraint"
      ],
      "name": "parameters",
      "schema": "dtmi:advantech:weda:transform:calibration:parameters;1",
      "required": false,
      "writable": true
    }
  ]
}