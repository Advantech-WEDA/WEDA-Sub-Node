  ],
  "@id": "dtmi:advantech:weda:command:reporthistorical:param;1",
  "@type": "Interface",
  "displayName": "report.historical param",
  "description": "Query historical telemetry within a time range and emit batched records.",
  "schemas": [
    {
      "@id": "dtmi:advantech:weda:command:reporthistorical:param:timerange;1",
      "@type": "Object",
      "fields": [
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "startTime",
          "schema": "long",
          "required": false,
          "writable": true
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "endTime",
          "schema": "long",
          "required": false,
          "writable": true
        }
      ]
    },
    {
      "@id": "dtmi:advantech:weda:command:reporthistorical:param:includelist;1",
      "@type": "Array",
      "elementSchema": "string"
    },
    {
      "@id": "dtmi:advantech:weda:command:reporthistorical:param:sensorfilter;1",
      "@type": "Object",
      "fields": [
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "include",
          "schema": "dtmi:advantech:weda:command:reporthistorical:param:includelist;1",
          "required": false,
          "writable": true
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "exclude",
          "schema": "dtmi:advantech:weda:command:reporthistorical:param:includelist;1",
          "required": false,
          "writable": true
        }
      ]
    },
    {
      "@id": "dtmi:advantech:weda:command:reporthistorical:param:parameters;1",
      "@type": "Object",
      "fields": [
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "timeRange",
          "displayName": "Time Range",
          "description": "Time range for historical data query (Unix milliseconds). Defaults to last 10 minutes when omitted.",
          "schema": "dtmi:advantech:weda:command:reporthistorical:param:timerange;1",
          "required": false,
          "writable": true
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "sensorFilter",
          "displayName": "Sensor Filter",
          "description": "Optional filter selecting which sensors to include / exclude.",
          "schema": "dtmi:advantech:weda:command:reporthistorical:param:sensorfilter;1",
          "required": false,
          "writable": true
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "maxBatchesPerMessage",
          "displayName": "Max Batches Per Message",
          "description": "Maximum number of batches per outbound message.",
          "schema": "integer",
          "required": false,
          "writable": true,
          "minimum": 1,
          "maximum": 1000,
          "default": 1
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "maxBatchSize",
          "displayName": "Max Batch Size",
          "description": "Maximum samples per batch. Larger sensor result sets are split into multiple batches.",
          "schema": "integer",
          "required": false,
          "writable": true,
          "minimum": 1,
          "maximum": 100000,
          "default": 10000
        },
        {
          "@type": [
            "Field",
            "ConfigConstraint"
          ],
          "name": "transmissionRateLimit",
          "displayName": "Transmission Rate Limit",
          "description": "Transmission rate limit (messages per second). 0 disables rate limiting.",
          "schema": "integer",
          "required": false,
          "writable": true,
          "minimum": 0,
          "maximum": 10000,
          "default": 0
        }
      ]
    }
  ],
  "contents": [
    {
      "@type": [
        "Property",
        "ConfigConstraint"
      ],
      "name": "parameters",
      "schema": "dtmi:advantech:weda:command:reporthistorical:param:parameters;1",
