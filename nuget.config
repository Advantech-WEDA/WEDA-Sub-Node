<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Self-contained: CI agents have no user-level nuget.org source, so
         define it here explicitly and ignore inherited machine/user sources. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="./nuget" />
  </packageSources>
  <!--
    Package source mapping is required because PackageSourceMapping is enabled
    at a higher level (machine / user config); without an explicit mapping here,
    our `local` source is excluded during restore.

    Weda.Dtdl is served from the bundled .nupkg under ./nuget/ until the
    package ships to NuGet.org; everything else falls through to nuget.org.
  -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Weda.Dtdl" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
