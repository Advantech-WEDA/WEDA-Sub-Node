{
  "SubNode": {
    "Name": "TestDeviceCmd",
    "SubNodeType": "AdamEthernet",
    "Manufacturer": "Advantech",
    "Model": "Demo",
    "SwVersion": "1.0.0"
  },
  "SubNodeSettings": {
    "Record": {
      "MinFreeDiskSpaceMb": 128,
      "MaxStorageSizeMb": 1024,
      "RetentionDays": 7
    }
  },
  "DeviceConfigs": {
    "MyFirstDeviceConfig": {
      "Enabled": true,
      "DeviceCommunication": {
        "Host": "127.0.0.1",
        "Port": 5020
      },
      "Dtdl": {
        "AutoGenEnabled": true
      },
      "Properties": {
        "SlaveId": 1
      },
      "Sensors": [
        {
          "Name": "hb",
          "SensorGroup": "SYS",
          "Report": {
            "Enabled": true,
            "Interval": 60000
          },
          "Record": {
            "Enabled": false
          },
          "SensorInfo": {
            "Schema": "boolean",
            "Description": "Reserved platform liveness ping. Declaring a sensor named 'hb' enables the SubNode heartbeat; it is never polled, its value is synthesized by the SDK, and its dtmi is supplied by the SDK. Schema is always stamped to boolean; it is declared here so the config satisfies the cloud sensorInfo envelope, where schema is required.",
            "DisplayName": "Heartbeat"
          }
        },
        {
          "Name": "temperature_sensor",
          "SensorGroup": "TEMP",
          "Parameters": {
            "RegisterType": "HoldingRegister",
            "RegisterAddress": 0,
            "RegisterCount": 2,
            "DataType": "Float32"
          },
          "SensorInfo": {
            "DisplayName": "Temperature Sensor",
            "Description": "Sensor for temperature sampling",
            "Schema": "double"
          },
          "Report": {
            "Enabled": true,
            "Interval": 500,
            "Unit": "celsius",
            "TransformPipeline": [
              {
                "Type": "UnitConversion",
                "Enabled": true,
                "Parameters": {
                  "FromUnit": "celsius",
                  "ToUnit": "fahrenheit"
                }
              },
              {
                "Type": "expression",
                "Enabled": true,
                "Parameters": {
                  "expression": "(value - 32) * 5 / 9",
                  "variableName": "value"
                }
              }
            ],
            "DspPipeline": [
              {
                "Type": "Kalman",
                "Enabled": true
              }
            ]
          },
          "Record": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
