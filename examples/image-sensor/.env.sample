# Copy to .env (same directory as docker-compose.yml) and tweak as needed.
# docker compose automatically loads .env; values here override docker-compose.yml defaults.

# === Image ===
# Override to pin a specific tag or point at a different registry.
# IMAGE_SENSOR_IMAGE=harbor.arfa.wise-paas.com/edge-coa/image-sensor:latest

# === WedaNode (NATS) ===
WEDA_NODE_URL=127.0.0.1:4224
WEDA_NODE_AUTH_STRATEGY=UserPassword
WEDA_NODE_USERNAME=advantech_nats
WEDA_NODE_PASSWORD=3671be64607240cbc2b95af99c9a3b28fb5f9aa3fbe51f501478f1a678e19d48

# Optional
# WEDA_NODE_NAME=default
# WEDA_NODE_SERIALIZER_TYPE=json

# --- Other auth strategies (uncomment one, set WEDA_NODE_AUTH_STRATEGY accordingly) ---
# WEDA_NODE_TOKEN=
# WEDA_NODE_CRED_FILE=/app/secrets/user.creds
# WEDA_NODE_TLS_CERT_PATH=/app/secrets/client.crt
# WEDA_NODE_TLS_KEY_PATH=/app/secrets/client.key
# WEDA_NODE_TLS_CA_PATH=/app/secrets/ca.crt

# === SubNode identity (reported to WedaNode) ===
# Override per host so each deployment registers under a unique Name.
SUBNODE_NAME=ImageSensor
# SUBNODE_TYPE=CustomDevice
# SUBNODE_MANUFACTURER=Advantech
# SUBNODE_MODEL=MNIST-Demo
# SUBNODE_SW_VERSION=1.0.0

# === Local recording quota ===
# RECORD_MIN_FREE_DISK_SPACE_MB=128
# RECORD_MAX_STORAGE_SIZE_MB=1024
# RECORD_RETENTION_DAYS=7
