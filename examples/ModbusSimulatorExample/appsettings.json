{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Debug" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/modbus-simulator-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "Properties": {
      "Application": "ModbusSimulatorExample"
    }
  },
  "TcpModbusSimulatorConfiguration": {
    "TcpConnection": {
      "IpAddress": "127.0.0.1",
      "Port": 5020
    },
    "ModbusProtocol": {
      "SlaveId": 1,
      "UseModbusAddressing": true,
      "HoldingRegisterBase": 40001
    },
    "Simulation": {
      "GlobalUpdateIntervalSeconds": 5,
      "EnableValueChanges": true
    },
    "Sensors": [
      {
        "Name": "TemperatureSensor",
        "Type": "Temperature",
        "StartAddress": 40001,
        "RegisterCount": 2,
        "DataType": "Float32",
        "SimulationParams": {
          "MinValue": 18.0,
          "MaxValue": 32.0,
          "InitialValue": 25.0,
          "ChangeRate": 0.2,
          "NoiseLevel": 0.1
        }
      },
      {
        "Name": "HumiditySensor",
        "Type": "Humidity",
        "StartAddress": 40003,
        "RegisterCount": 2,
        "DataType": "Float32",
        "SimulationParams": {
          "MinValue": 30.0,
          "MaxValue": 80.0,
          "InitialValue": 55.0,
          "ChangeRate": 0.5,
          "NoiseLevel": 0.2
        }
      },
      {
        "Name": "PressureSensor",
        "Type": "Pressure",
        "StartAddress": 40005,
        "RegisterCount": 2,
        "DataType": "Float32",
        "SimulationParams": {
          "MinValue": 980.0,
          "MaxValue": 1030.0,
          "InitialValue": 1013.25,
          "ChangeRate": 0.1,
          "NoiseLevel": 0.05
        }
      },
      {
        "Name": "VoltageSensor",
        "Type": "Voltage",
        "StartAddress": 40007,
        "RegisterCount": 2,
        "DataType": "Float32",
        "SimulationParams": {
          "MinValue": 220.0,
          "MaxValue": 240.0,
          "InitialValue": 230.0,
          "ChangeRate": 0.5,
          "NoiseLevel": 0.3
        }
      },
      {
        "Name": "CurrentSensor",
        "Type": "Current",
        "StartAddress": 40009,
        "RegisterCount": 2,
        "DataType": "Float32",
        "SimulationParams": {
          "MinValue": 0.0,
          "MaxValue": 10.0,
          "InitialValue": 5.0,
          "ChangeRate": 1.0,
          "NoiseLevel": 0.2
        }
      }
    ]
  }
}
