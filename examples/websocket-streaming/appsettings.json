          "Location": "Remote Server"
        }
      },
      "Periods": {
        "ReportHealth": 60000
      },
      "ConnectionSettings": {
        "ConnectionTimeoutMs": 30000,
        "ReadTimeoutMs": 5000,
        "WriteTimeoutMs": 5000,
        "RetryCount": 3,
        "RetryDelayMs": 1000
      },
      "Sensors": [
