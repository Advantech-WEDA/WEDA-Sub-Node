          "Dtmi": "dtmi:advantech:EdgeSync:Sensor:Temperature;1",
          "SensorGroup": "ENV",
          "Config": {
            "Enabled": true,
            "Interval": 1000
          }
        },
        {
          "ResourceId": "humidity-sensor-1",
          "Name": "humidity1",
          "Dtmi": "dtmi:advantech:EdgeSync:Sensor:Humidity;1",
          "SensorGroup": "ENV",
          "Config": {
            "Enabled": true,
