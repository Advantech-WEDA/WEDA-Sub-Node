{
  "@id": "dtmi:advantech:EdgeSync:SystemAgent:GpuResource;1",
  "@type": "Interface",
  "@context": "dtmi:dtdl:context;2",
  "displayName": "System Agent — GPU Resource Telemetry",
  "description": "DTDL v2 schema for the gpu MetricType. Single-MetricType Interface; one Telemetry per supported NVML counter. schemas[] publishes reusable Enums; every Telemetry's comment carries its validation rule.",
  "schemas": [
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:GpuResource:MetricType;1",
      "@type": "Enum",
      "valueSchema": "string",
      "description": "Allowed MetricType discriminators in this Interface.",
      "enumValues": [
        { "name": "Gpu", "enumValue": "gpu", "displayName": "GPU" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:GpuResource:GpuMetricName;1",
      "@type": "Enum",
      "valueSchema": "string",
      "description": "Allowed values of Parameters.MetricName when MetricType == 'gpu'.",
      "enumValues": [
        { "name": "Utilization", "enumValue": "utilization", "displayName": "GPU Utilization (%)" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:GpuResource:SensorGroup;1",
      "@type": "Enum",
      "valueSchema": "string",
      "description": "Allowed values of SensorGroup. GPU sensors conventionally use 'SYS'.",
      "enumValues": [
        { "name": "AI",   "enumValue": "AI",   "displayName": "Analog Input" },
        { "name": "AO",   "enumValue": "AO",   "displayName": "Analog Output" },
        { "name": "DI",   "enumValue": "DI",   "displayName": "Digital Input" },
        { "name": "DO",   "enumValue": "DO",   "displayName": "Digital Output" },
        { "name": "TEMP", "enumValue": "TEMP", "displayName": "Temperature" },
        { "name": "PWR",  "enumValue": "PWR",  "displayName": "Power" },
        { "name": "SYS",  "enumValue": "SYS",  "displayName": "System" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:GpuResource:SensorInfoSchema;1",
      "@type": "Enum",
      "valueSchema": "string",
      "description": "Allowed values of SensorInfo.Schema; must additionally match the Telemetry's native DTDL schema.",
      "enumValues": [
        { "name": "Double",  "enumValue": "double",  "displayName": "double" },
        { "name": "Long",    "enumValue": "long",    "displayName": "long" },
        { "name": "Integer", "enumValue": "integer", "displayName": "integer" },
        { "name": "Boolean", "enumValue": "boolean", "displayName": "boolean" },
        { "name": "String",  "enumValue": "string",  "displayName": "string" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:GpuResource:GpuSensorParameters;1",
      "@type": "Object",
      "displayName": "GPU Sensor Parameters",
      "description": "Reusable Object schema for the Parameters block of every gpu Sensor in devicecfg.json. GPU sensors take no type-specific extra parameters.",
      "fields": [
        { "name": "metricType", "displayName": "Metric Type", "schema": "dtmi:advantech:EdgeSync:SystemAgent:GpuResource:MetricType;1",     "description": "MUST equal 'gpu'." },
        { "name": "metricName", "displayName": "Metric Name", "schema": "dtmi:advantech:EdgeSync:SystemAgent:GpuResource:GpuMetricName;1", "description": "Specific GPU metric (see GpuMetricName enum)." }
      ]
    }
  ],
  "contents": [
    {
      "@id": "dtmi:advantech:EdgeSync:SystemInfo:GpuUtilization;1",
      "@type": "Telemetry",
      "name": "GpuUtilization",
      "displayName": "GPU Utilization",
      "schema": "integer",
      "description": "Fraction of last sample period with active GPU kernels (NVML 'gpu' field, 0-100). MetricType=gpu, MetricName=utilization.",
      "comment": "Validation: 0 <= v <= 100; null/suppressed on hosts without NVIDIA hardware."
    }
  ]
}
