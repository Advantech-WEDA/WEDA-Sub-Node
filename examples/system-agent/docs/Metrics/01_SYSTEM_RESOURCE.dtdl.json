          "displayName": "Bytes Sent"
        },
        {
          "name": "BytesReceived",
          "enumValue": "bytes_received",
          "displayName": "Bytes Received"
        },
        {
          "name": "PacketsSent",
          "enumValue": "packets_sent",
          "displayName": "Packets Sent"
        },
        {
          "name": "PacketsReceived",
          "enumValue": "packets_received",
          "displayName": "Packets Received"
        },
        {
          "name": "Errors",
          "enumValue": "errors",
