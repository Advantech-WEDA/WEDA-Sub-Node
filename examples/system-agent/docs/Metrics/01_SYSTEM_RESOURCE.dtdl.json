    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:CpuSensorParameters;1",
      "@type": "Object",
      "displayName": "CPU Sensor Parameters",
      "description": "Reusable Object schema for the Parameters block of every cpu Sensor in devicecfg.json. CPU sensors take no type-specific extra parameters.",
      "fields": [
        {
          "name": "metricType",
          "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MetricType;1",
          "description": "MUST equal 'cpu'."
        },
        {
          "name": "metricName",
          "displayName": "Metric Name",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:CpuMetricName;1",
          "description": "Specific CPU statistic (see CpuMetricName enum)."
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MemorySensorParameters;1",
      "@type": "Object",
      "displayName": "Memory Sensor Parameters",
      "description": "Reusable Object schema for the Parameters block of every memory Sensor in devicecfg.json. Memory sensors take no type-specific extra parameters.",
      "fields": [
        {
          "name": "metricType",
          "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MetricType;1",
          "description": "MUST equal 'memory'."
        },
        {
          "name": "metricName",
          "displayName": "Metric Name",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MemoryMetricName;1",
          "description": "Specific memory metric (see MemoryMetricName enum)."
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:DiskSensorParameters;1",
      "@type": "Object",
      "displayName": "Disk Sensor Parameters",
      "description": "Reusable Object schema for the Parameters block of every disk Sensor in devicecfg.json. Disk sensors require Parameters.MountPoint.",
      "comment": "DTDL v2 has no 'required field' or 'minLength' attribute, so one rule lives outside the schema and is enforced by dtdl-validate/scripts/config-rules.js (rules.disk) and ConfigRules.MountPointRequired: Parameters.MountPoint is REQUIRED for every disk Sensor and MUST be a non-empty string. There is no auto-detect mode for disk -- a missing or empty MountPoint is a hard validation failure.",
      "fields": [
        {
          "name": "metricType",
          "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MetricType;1",
          "description": "MUST equal 'disk'."
        },
        {
          "name": "metricName",
          "displayName": "Metric Name",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:DiskMetricName;1",
          "description": "Specific disk metric (see DiskMetricName enum)."
        },
        {
          "name": "mountPoint",
          "displayName": "Mount Point",
          "schema": "string",
          "description": "Filesystem mount path to monitor (e.g. '/', '/data', 'C:\\\\'). REQUIRED -- DTDL v2 cannot express required fields, so the rule is enforced by config-rules.js (rules.disk).",
          "comment": "VALIDATION RULE: Parameters.MountPoint MUST be present AND MUST be a non-empty string. Empty string, null, missing key, or non-string types are all hard failures. Enforced by dtdl-validate/scripts/config-rules.js:rules.disk and ConfigRules.MountPointRequired."
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:SystemMetricName;1",
      "@type": "Enum",
      "valueSchema": "string",
      "description": "Allowed values of Parameters.MetricName when MetricType == 'system'.",
      "enumValues": [
        {
          "name": "Time",
          "enumValue": "time",
          "displayName": "Wall-Clock Time"
        },
        {
          "name": "TimexOffset",
          "enumValue": "timex_offset",
          "displayName": "NTP Offset"
        },
        {
          "name": "BootTime",
          "enumValue": "boot_time",
          "displayName": "Boot Time"
        },
        {
          "name": "FilefdAllocated",
          "enumValue": "filefd_allocated",
          "displayName": "Allocated File Descriptors"
        },
        {
          "name": "FilefdMaximum",
          "enumValue": "filefd_maximum",
          "displayName": "Max File Descriptors"
        },
        {
          "name": "ProcsRunning",
          "enumValue": "procs_running",
          "displayName": "Running Processes"
        },
        {
          "name": "ProcsBlocked",
          "enumValue": "procs_blocked",
          "displayName": "Blocked Processes"
        },
        {
          "name": "IntrTotal",
          "enumValue": "intr_total",
          "displayName": "Total Interrupts"
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:SystemSensorParameters;1",
      "@type": "Object",
      "displayName": "System Sensor Parameters",
      "description": "Reusable Object schema for the Parameters block of every system Sensor in devicecfg.json. System sensors take no type-specific extra parameters.",
      "fields": [
        {
          "name": "metricType",
          "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MetricType;1",
          "description": "MUST equal 'system'."
        },
        {
          "name": "metricName",
          "displayName": "Metric Name",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:SystemMetricName;1",
          "description": "Specific system metric (see SystemMetricName enum)."
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:NetworkSensorParameters;1",
      "@type": "Object",
      "displayName": "Network Sensor Parameters",
      "description": "Reusable Object schema for the Parameters block of every network Sensor in devicecfg.json. Field names are camelCase; on-the-wire keys are PascalCase (the agent matches case-insensitively).",
      "comment": "DTDL v2 lacks union types and cross-field constraints. Two runtime rules live outside this schema and are enforced by dtdl-validate/scripts/config-rules.js: (1) 'interfaces' may also appear on the wire as a CSV string; (2) 'interface' and 'interfaces' are mutually exclusive when both non-empty.",
      "fields": [
        {
          "name": "metricType",
          "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MetricType;1",
          "description": "MUST equal 'network'."
        },
        {
          "name": "metricName",
          "displayName": "Metric Name",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:NetworkMetricName;1",
          "description": "Specific network metric (see NetworkMetricName enum)."
        },
        {
          "name": "interface",
          "displayName": "Bound Interface (v1.0)",
          "schema": "string",
          "description": "Single OS-level interface name. v1.0 mode: required. v1.1 mode: optional; when set disables expansion."
        },
        {
          "name": "interfaces",
          "displayName": "Interface List (v1.1)",
          "schema": {
            "@type": "Array",
            "elementSchema": "string"
          },
          "description": "Array of OS-level interface names. v1.1 only. Each entry expands to one sensor sharing the parent Telemetry DTMI. Empty array => auto-detect."
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:SensorInfo;1",
      "@type": "Object",
      "displayName": "Sensor Info",
      "description": "Reusable Object schema for the SensorInfo block of every Sensor in devicecfg.json. Models the wire-output metadata: declared schema, operator-facing display strings, and the read/write directionality contract.",
      "comment": "SIL2 read-only contract: every Sensor declared in devicecfg.json represents an agent-emitted reading. Consumers MUST set isReadable=true and isWritable=false; the agent rejects writes (WriteSensorDataAsync returns false) and commands (ExecuteCommandAsync returns CommandNotSupported) by design. A future writable GPIO-output extension would introduce its own MetricType with isWritable=true; existing read-direction MetricTypes never flip writability.",
      "fields": [
        {
          "name": "schema",
          "displayName": "Wire Schema",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:SensorInfoSchema;1",
          "description": "On-the-wire JSON type the agent emits for this Sensor's Value (matches the per-MetricName schema documented in the *_FIELDS.md reference). The agent rejects startup if SensorInfo.Schema disagrees with the runtime type."
        },
        {
          "name": "description",
          "schema": "string",
          "description": "Long-form operator-facing description shown in dashboards and audit logs."
        },
        {
          "name": "displayName",
          "schema": "string",
          "description": "Short label for UI render (twin pages, alert subjects). Distinct from Sensor.Name, which is the wire identifier."
        },
        {
          "name": "isReadable",
          "displayName": "Is Readable",
          "schema": "boolean",
          "description": "True when the Sensor produces readings the agent forwards as telemetry. MUST be true for all sensors declared in this Interface (the agent is read-direction by design). Default: true."
        },
        {
          "name": "isWritable",
          "displayName": "Is Writable",
          "schema": "boolean",
          "description": "True when the Sensor accepts writes from the cloud. MUST be false for every sensor declared in this Interface; the agent rejects writes and commands per SIL2 fail-safe contract. Default: false."
        }
      ]
    }
  ],
  "contents": []
}
