          "enumValue": "swap_free",
          "displayName": "Free Swap"
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:DiskMetricName;1",
      "@type": "Enum",
      "valueSchema": "string",
      "description": "Allowed values of Parameters.MetricName when MetricType == 'disk'. Each disk sensor must also set Parameters.MountPoint.",
      "enumValues": [
        {
          "name": "Total",
          "enumValue": "total",
