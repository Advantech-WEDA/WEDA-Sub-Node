      "enumValues": [
        {
          "name": "SYS",
          "enumValue": "SYS",
          "displayName": "System"
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:SensorInfoSchema;1",
      "@type": "Enum",
      "valueSchema": "string",
      "description": "Allowed values of SensorInfo.Schema; must additionally match the Telemetry's native DTDL schema.",
      "enumValues": [
        {
          "name": "Double",
          "enumValue": "double",
          "displayName": "double"
        },
        {
          "name": "Long",
          "enumValue": "long",
          "displayName": "long"
        },
        {
          "name": "Integer",
