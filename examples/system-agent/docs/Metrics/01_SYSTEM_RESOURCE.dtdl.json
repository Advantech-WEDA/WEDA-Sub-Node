        },
        {
          "name": "Load15",
          "enumValue": "load15",
          "displayName": "15-Minute Load Average"
        },
        {
          "name": "ContextSwitches",
          "enumValue": "context_switches",
          "displayName": "Context Switches"
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MemoryMetricName;1",
