    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:MetricType;1",
      "@type": "Enum",
      "valueSchema": "string",
      "description": "Allowed MetricType discriminators in this Interface.",
      "enumValues": [
        {
          "name": "Cpu",
          "enumValue": "cpu",
          "displayName": "CPU"
        },
        {
          "name": "Memory",
          "enumValue": "memory",
          "displayName": "Memory"
        },
        {
          "name": "Disk",
          "enumValue": "disk",
          "displayName": "Disk"
        },
        {
          "name": "Network",
          "enumValue": "network",
          "displayName": "Network"
        },
        {
          "name": "System",
          "enumValue": "system",
          "displayName": "System"
        }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:SystemResource:CpuMetricName;1",
      "@type": "Enum",
      "valueSchema": "string",
