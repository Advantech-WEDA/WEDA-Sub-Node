{
  "@context": [
    "dtmi:dtdl:context;3",
    "dtmi:advantech:edgesync:validation;1"
  ],
  "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor;1",
  "@type": "Interface",
  "displayName": "Network Sensor (System Resource)",
  "description": "Validation schema for one network Sensor entry of devicecfg.json Sensors[]. Every Property and Field is co-typed ConfigConstraint (dtmi:advantech:edgesync:validation;1): required, writable, and value bounds (minimum/maximum, minLength/maxLength). Interface (v1.0) and Interfaces (v1.1 array) are optional; their mutual exclusivity is a cross-field rule outside this schema.",
  "schemas": [
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:MetricType;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Metric Type",
      "enumValues": [ { "name": "Network", "enumValue": "network", "displayName": "Network" } ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:NetworkMetricName;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Metric Name",
      "enumValues": [
        { "name": "BytesSent",       "enumValue": "bytes_sent",       "displayName": "Bytes Sent" },
        { "name": "BytesReceived",   "enumValue": "bytes_received",   "displayName": "Bytes Received" },
        { "name": "PacketsSent",     "enumValue": "packets_sent",     "displayName": "Packets Sent" },
        { "name": "PacketsReceived", "enumValue": "packets_received", "displayName": "Packets Received" },
        { "name": "Errors",          "enumValue": "errors",           "displayName": "Errors (Total)" },
        { "name": "ErrorsIn",        "enumValue": "errors_in",        "displayName": "RX Errors" },
        { "name": "ErrorsOut",       "enumValue": "errors_out",       "displayName": "TX Errors" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:SensorGroup;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Sensor Group",
      "enumValues": [ { "name": "SYS", "enumValue": "SYS", "displayName": "System" } ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:WireSchema;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Wire Schema",
      "enumValues": [ { "name": "Long", "enumValue": "long", "displayName": "long" } ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:InterfaceList;1",
      "@type": "Array", "displayName": "Interface List", "elementSchema": "string"
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:Parameters;1",
      "@type": "Object", "displayName": "Network Parameters",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "MetricType", "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:MetricType;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "MetricName", "displayName": "Metric Name",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:NetworkMetricName;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "Interface", "displayName": "Bound Interface (v1.0)",
          "schema": "string", "required": false, "writable": true,
          "minLength": 1, "maxLength": 64,
          "mutexGroup": "networkBinding" },
        { "@type": ["Field", "ConfigConstraint"], "name": "Interfaces", "displayName": "Interface List (v1.1)",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:InterfaceList;1",
          "required": false, "writable": true,
          "mutexGroup": "networkBinding", "csvStringAccepted": true }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:Report;1",
      "@type": "Object", "displayName": "Report",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "Enabled", "displayName": "Enabled",
          "schema": "boolean", "required": true, "writable": true },
        { "@type": ["Field", "ConfigConstraint"], "name": "Interval", "displayName": "Interval (ms)",
          "schema": "integer", "required": true, "writable": true,
          "minimum": 1, "maximum": 300000 }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:SensorInfo;1",
      "@type": "Object", "displayName": "Sensor Info",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "Schema", "displayName": "Wire Schema",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:WireSchema;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "Description", "displayName": "Description",
          "schema": "string", "required": true, "writable": true,
          "minLength": 1, "maxLength": 512 },
        { "@type": ["Field", "ConfigConstraint"], "name": "DisplayName", "displayName": "Display Name",
          "schema": "string", "required": true, "writable": true,
          "minLength": 1, "maxLength": 64 }
      ]
    }
  ],
  "contents": [
    { "@type": ["Property", "ConfigConstraint"], "name": "Name", "displayName": "Sensor Name",
      "schema": "string", "writable": false, "required": true,
      "minLength": 1, "maxLength": 128 },
    { "@type": ["Property", "ConfigConstraint"], "name": "SensorGroup", "displayName": "Sensor Group",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:SensorGroup;1",
      "writable": false, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "Parameters", "displayName": "Parameters",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:Parameters;1",
      "writable": false, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "Report", "displayName": "Report",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:Report;1",
      "writable": true, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "SensorInfo", "displayName": "Sensor Info",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:NetworkSensor:SensorInfo;1",
      "writable": true, "required": true }
  ]
}
