{
  "@context": [
    "dtmi:dtdl:context;3",
    "dtmi:advantech:edgesync:validation;1"
  ],
  "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor;1",
  "@type": "Interface",
  "displayName": "Temperature Sensor (Onboard Sensor)",
  "description": "Validation schema for one temperature Sensor entry of devicecfg.json Sensors[]. Every Property and Field is co-typed ConfigConstraint (dtmi:advantech:edgesync:validation;1). MetricName is a free-form non-empty string ('therm' for v1.1, or the source name itself for v1.0). Source / Sources are mutually exclusive and allowed only when MetricName='therm'.",
  "schemas": [
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:MetricType;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Metric Type",
      "enumValues": [ { "name": "Temperature", "enumValue": "temperature", "displayName": "Temperature" } ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:SensorGroup;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Sensor Group",
      "enumValues": [
        { "name": "AI",   "enumValue": "AI",   "displayName": "Analog Input" },
        { "name": "AO",   "enumValue": "AO",   "displayName": "Analog Output" },
        { "name": "DI",   "enumValue": "DI",   "displayName": "Digital Input" },
        { "name": "DO",   "enumValue": "DO",   "displayName": "Digital Output" },
        { "name": "TEMP", "enumValue": "TEMP", "displayName": "Temperature" },
        { "name": "PWR",  "enumValue": "PWR",  "displayName": "Power" },
        { "name": "SYS",  "enumValue": "SYS",  "displayName": "System" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:WireSchema;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Wire Schema",
      "enumValues": [ { "name": "Double", "enumValue": "double", "displayName": "double" } ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:SourceList;1",
      "@type": "Array", "displayName": "Source List", "elementSchema": "string"
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:Parameters;1",
      "@type": "Object", "displayName": "Temperature Parameters",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "MetricType", "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:MetricType;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "MetricName", "displayName": "Metric Name",
          "schema": "string", "required": true, "writable": false,
          "minLength": 1, "maxLength": 64 },
        { "@type": ["Field", "ConfigConstraint"], "name": "Source", "displayName": "Thermal Source (v1.1)",
          "schema": "string", "required": false, "writable": false,
          "minLength": 1, "maxLength": 64,
          "mutexGroup": "tempSource",
          "allowedOnlyWhen": { "field": "MetricName", "equals": "therm" } },
        { "@type": ["Field", "ConfigConstraint"], "name": "Sources", "displayName": "Thermal Source List (v1.1)",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:SourceList;1",
          "required": false, "writable": false,
          "mutexGroup": "tempSource",
          "allowedOnlyWhen": { "field": "MetricName", "equals": "therm" } }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:Report;1",
      "@type": "Object", "displayName": "Report",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "Enabled", "displayName": "Enabled",
          "schema": "boolean", "required": true, "writable": true },
        { "@type": ["Field", "ConfigConstraint"], "name": "Interval", "displayName": "Interval (ms)",
          "schema": "integer", "required": true, "writable": true,
          "minimum": 1, "maximum": 300000 }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:SensorInfo;1",
      "@type": "Object", "displayName": "Sensor Info",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "Schema", "displayName": "Wire Schema",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:WireSchema;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "Description", "displayName": "Description",
          "schema": "string", "required": true, "writable": true,
          "minLength": 1, "maxLength": 512 },
        { "@type": ["Field", "ConfigConstraint"], "name": "DisplayName", "displayName": "Display Name",
          "schema": "string", "required": true, "writable": true,
          "minLength": 1, "maxLength": 64 }
      ]
    }
  ],
  "contents": [
    { "@type": ["Property", "ConfigConstraint"], "name": "Name", "displayName": "Sensor Name",
      "schema": "string", "writable": false, "required": true,
      "minLength": 1, "maxLength": 64 },
    { "@type": ["Property", "ConfigConstraint"], "name": "SensorGroup", "displayName": "Sensor Group",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:SensorGroup;1",
      "writable": false, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "Parameters", "displayName": "Parameters",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:Parameters;1",
      "writable": false, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "Report", "displayName": "Report",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:Report;1",
      "writable": true, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "SensorInfo", "displayName": "Sensor Info",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:TemperatureSensor:SensorInfo;1",
      "writable": true, "required": true }
  ]
}
