{
  "@context": [
    "dtmi:dtdl:context;3",
    "dtmi:advantech:edgesync:validation;1"
  ],
  "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor;1",
  "@type": "Interface",
  "displayName": "GPIO Sensor (Hardware Feature)",
  "description": "Validation schema for one gpio Sensor entry of devicecfg.json Sensors[]. Covers both MetricNames: isSupported (boolean, no extra Parameters) and pinState (integer, with PinId / PinIds). Every Property and Field is co-typed ConfigConstraint (dtmi:advantech:edgesync:validation;1). Cross-field rules -- Schema must be boolean for isSupported / integer for pinState, PinId-PinIds priority, PinId/PinIds only valid for pinState -- are NOT expressible in DTDL+extension and remain in config-rules.js.",
  "schemas": [
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:MetricType;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Metric Type",
      "enumValues": [ { "name": "Gpio", "enumValue": "gpio", "displayName": "GPIO" } ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:GpioMetricName;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Metric Name",
      "enumValues": [
        { "name": "IsSupported", "enumValue": "isSupported", "displayName": "GPIO Supported" },
        { "name": "PinState",    "enumValue": "pinState",    "displayName": "GPIO Pin State" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:SensorGroup;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Sensor Group",
      "enumValues": [
        { "name": "AI",   "enumValue": "AI",   "displayName": "Analog Input" },
        { "name": "AO",   "enumValue": "AO",   "displayName": "Analog Output" },
        { "name": "DI",   "enumValue": "DI",   "displayName": "Digital Input" },
        { "name": "DO",   "enumValue": "DO",   "displayName": "Digital Output" },
        { "name": "TEMP", "enumValue": "TEMP", "displayName": "Temperature" },
        { "name": "PWR",  "enumValue": "PWR",  "displayName": "Power" },
        { "name": "SYS",  "enumValue": "SYS",  "displayName": "System" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:WireSchema;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Wire Schema",
      "enumValues": [
        { "name": "Boolean", "enumValue": "boolean", "displayName": "boolean (isSupported)" },
        { "name": "Integer", "enumValue": "integer", "displayName": "integer (pinState; 0=Low, 1=High)" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:PinIdList;1",
      "@type": "Array", "displayName": "Pin Index List", "elementSchema": "integer"
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:Parameters;1",
      "@type": "Object", "displayName": "GPIO Parameters",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "MetricType", "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:MetricType;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "MetricName", "displayName": "Metric Name",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:GpioMetricName;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "PinId", "displayName": "Pin Index (bound mode)",
          "schema": "integer", "required": false, "writable": false,
          "minimum": 0,
          "mutexGroup": "gpioPin",
          "allowedOnlyWhen": { "field": "MetricName", "equals": "pinState" } },
        { "@type": ["Field", "ConfigConstraint"], "name": "PinIds", "displayName": "Pin Index List (v1.1)",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:PinIdList;1",
          "required": false, "writable": false,
          "mutexGroup": "gpioPin",
          "allowedOnlyWhen": { "field": "MetricName", "equals": "pinState" } }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:Report;1",
      "@type": "Object", "displayName": "Report",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "Enabled", "displayName": "Enabled",
          "schema": "boolean", "required": true, "writable": true },
        { "@type": ["Field", "ConfigConstraint"], "name": "Interval", "displayName": "Interval (ms)",
          "schema": "integer", "required": true, "writable": true,
          "minimum": 1, "maximum": 300000 }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:SensorInfo;1",
      "@type": "Object", "displayName": "Sensor Info",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "Schema", "displayName": "Wire Schema",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:WireSchema;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "Description", "displayName": "Description",
          "schema": "string", "required": true, "writable": true,
          "minLength": 1, "maxLength": 512 },
        { "@type": ["Field", "ConfigConstraint"], "name": "DisplayName", "displayName": "Display Name",
          "schema": "string", "required": true, "writable": true,
          "minLength": 1, "maxLength": 64 }
      ]
    }
  ],
  "contents": [
    { "@type": ["Property", "ConfigConstraint"], "name": "Name", "displayName": "Sensor Name",
      "schema": "string", "writable": false, "required": true,
      "minLength": 1, "maxLength": 64 },
    { "@type": ["Property", "ConfigConstraint"], "name": "SensorGroup", "displayName": "Sensor Group",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:SensorGroup;1",
      "writable": false, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "Parameters", "displayName": "Parameters",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:Parameters;1",
      "writable": false, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "Report", "displayName": "Report",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:Report;1",
      "writable": true, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "SensorInfo", "displayName": "Sensor Info",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpioSensor:SensorInfo;1",
      "writable": true, "required": true }
  ]
}
