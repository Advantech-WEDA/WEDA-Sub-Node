{
  "@context": [
    "dtmi:dtdl:context;3",
    "dtmi:advantech:edgesync:validation;1"
  ],
  "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor;1",
  "@type": "Interface",
  "displayName": "GPU Sensor (System Resource)",
  "description": "Validation schema for one gpu Sensor entry of devicecfg.json Sensors[]. Every Property and Field is co-typed ConfigConstraint (dtmi:advantech:edgesync:validation;1): required, writable, and value bounds (minimum/maximum, minLength/maxLength). gpu takes no type-specific Parameters; SensorInfo.Schema is always 'integer'.",
  "schemas": [
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:MetricType;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Metric Type",
      "enumValues": [ { "name": "Gpu", "enumValue": "gpu", "displayName": "GPU" } ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:GpuMetricName;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Metric Name",
      "enumValues": [
        { "name": "Utilization", "enumValue": "utilization", "displayName": "GPU Utilization (%)" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:SensorGroup;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Sensor Group",
      "enumValues": [
        { "name": "AI",   "enumValue": "AI",   "displayName": "Analog Input" },
        { "name": "AO",   "enumValue": "AO",   "displayName": "Analog Output" },
        { "name": "DI",   "enumValue": "DI",   "displayName": "Digital Input" },
        { "name": "DO",   "enumValue": "DO",   "displayName": "Digital Output" },
        { "name": "TEMP", "enumValue": "TEMP", "displayName": "Temperature" },
        { "name": "PWR",  "enumValue": "PWR",  "displayName": "Power" },
        { "name": "SYS",  "enumValue": "SYS",  "displayName": "System" }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:WireSchema;1",
      "@type": "Enum", "valueSchema": "string", "displayName": "Wire Schema",
      "enumValues": [ { "name": "Integer", "enumValue": "integer", "displayName": "integer" } ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:Parameters;1",
      "@type": "Object", "displayName": "GPU Parameters",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "MetricType", "displayName": "Metric Type",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:MetricType;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "MetricName", "displayName": "Metric Name",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:GpuMetricName;1",
          "required": true, "writable": false }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:Report;1",
      "@type": "Object", "displayName": "Report",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "Enabled", "displayName": "Enabled",
          "schema": "boolean", "required": true, "writable": true,
          "description": "When true the agent samples and publishes this sensor; when false it is configured but dormant.",
          "default": true },
        { "@type": ["Field", "ConfigConstraint"], "name": "Interval", "displayName": "Interval (ms)",
          "schema": "integer", "required": true, "writable": true,
          "minimum": 1, "maximum": 300000,
          "description": "Publishing cadence in milliseconds.",
          "default": 5000 }
      ]
    },
    {
      "@id": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:SensorInfo;1",
      "@type": "Object", "displayName": "Sensor Info",
      "fields": [
        { "@type": ["Field", "ConfigConstraint"], "name": "Schema", "displayName": "Wire Schema",
          "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:WireSchema;1",
          "required": true, "writable": false },
        { "@type": ["Field", "ConfigConstraint"], "name": "Description", "displayName": "Description",
          "schema": "string", "required": true, "writable": true,
          "minLength": 1, "maxLength": 512,
          "description": "Long-form operator-facing description shown in dashboards and audit logs." },
        { "@type": ["Field", "ConfigConstraint"], "name": "DisplayName", "displayName": "Display Name",
          "schema": "string", "required": true, "writable": true,
          "minLength": 1, "maxLength": 64,
          "description": "Short human-readable label shown in UI lists and twin pages." }
      ]
    }
  ],
  "contents": [
    { "@type": ["Property", "ConfigConstraint"], "name": "Name", "displayName": "Sensor Name",
      "schema": "string", "writable": false, "required": true,
      "minLength": 1, "maxLength": 64 },
    { "@type": ["Property", "ConfigConstraint"], "name": "SensorGroup", "displayName": "Sensor Group",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:SensorGroup;1",
      "writable": false, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "Parameters", "displayName": "Parameters",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:Parameters;1",
      "writable": false, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "Report", "displayName": "Report",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:Report;1",
      "writable": true, "required": true },
    { "@type": ["Property", "ConfigConstraint"], "name": "SensorInfo", "displayName": "Sensor Info",
      "schema": "dtmi:advantech:EdgeSync:SystemAgent:DeviceCfg:GpuSensor:SensorInfo;1",
      "writable": true, "required": true }
  ]
}
