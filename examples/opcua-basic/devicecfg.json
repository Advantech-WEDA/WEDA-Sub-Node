{
  "SubNode": {
    "Name": "OpcUaDevice",
    "SubNodeType": "CustomDevice",
    "Manufacturer": "Advantech",
    "Model": "OPC-UA Demo",
    "SwVersion": "1.0.0"
  },
  "SubNodeSettings": {
    "Record": {
      "MinFreeDiskSpaceMb": 128,
      "MaxStorageSizeMb": 1024,
      "RetentionDays": 7
    }
  },
  "DeviceConfigs": {
    "MyOpcUaDeviceConfig": {
      "Enabled": true,
      "DeviceCommunication": {
        "EndpointUrl": "opc.tcp://localhost:4840/WedaOpcUaSimulator",
        "SecurityMode": "None",
        "AuthType": "Anonymous"
      },
      "Dtdl": {
        "AutoGenEnabled": true
      },
      "Properties": {},
      "Sensors": [
        {
          "Name": "hb",
          "SensorGroup": "SYS",
          "Parameters": {},
          "Report": {
            "Enabled": true,
            "Interval": 60000
          },
          "Record": {
            "Enabled": false
          },
          "SensorInfo": {
            "Schema": "boolean",
            "Description": "Reserved platform liveness ping. Declaring a sensor named 'hb' enables the SubNode heartbeat; it is never polled, its value is synthesized by the SDK, and its dtmi is supplied by the SDK. Schema is always stamped to boolean; it is declared here so the config satisfies the cloud sensorInfo envelope, where schema is required.",
            "DisplayName": "Heartbeat"
          }
        },
        {
          "Name": "temperature_sensor",
          "SensorGroup": "TEMP",
          "Parameters": {
            "NodeId": "Temperature",
            "NamespaceIndex": 2,
            "DataType": "Float"
          },
          "SensorInfo": {
            "DisplayName": "Temperature Sensor",
            "Description": "OPC-UA temperature node reading",
            "Schema": "double"
          },
          "Report": {
            "Enabled": true,
            "Interval": 5000,
            "Unit": "celsius"
          },
          "Record": {
            "Enabled": false
          }
        },
        {
          "Name": "humidity_sensor",
          "SensorGroup": "AI",
          "Parameters": {
            "NodeId": "Humidity",
            "NamespaceIndex": 2,
            "DataType": "Float"
          },
          "SensorInfo": {
            "DisplayName": "Humidity Sensor",
            "Description": "OPC-UA humidity node reading",
            "Schema": "double"
          },
          "Report": {
            "Enabled": true,
            "Interval": 5000,
            "Unit": "percent"
          },
          "Record": {
            "Enabled": false
          }
        },
        {
          "Name": "pressure_sensor",
          "SensorGroup": "AI",
          "Parameters": {
            "NodeId": "Pressure",
            "NamespaceIndex": 2,
            "DataType": "Float"
          },
          "SensorInfo": {
            "DisplayName": "Pressure Sensor",
            "Description": "OPC-UA pressure node reading",
            "Schema": "double"
          },
          "Report": {
            "Enabled": true,
            "Interval": 5000,
            "Unit": "hPa"
          },
          "Record": {
            "Enabled": false
          }
        }
      ]
    }
  }
}
