# Copy to .env (gitignored) and fill in.

# MQTT password for the CFX AMQP-to-MQTT bridge (RabbitMQ with rabbitmq_mqtt).
# For the local dev bridge, read it from the container rather than pasting a guess:
#
#   docker inspect cfx-rabbitmq --format '{{range .Config.Env}}{{println .}}{{end}}' \
#     | grep RABBITMQ_DEFAULT_PASS
#
CFX_BROKER_PASSWORD=

# WedaNode (NATS) password for the dmagent this SubNode registers with:
#
#   ssh <device> 'docker inspect dmagent --format "{{range .Config.Env}}{{println .}}{{end}}"' \
#     | grep NATS_
#
WEDA_NATS_PASSWORD=
