          },
          "Report": {
            "Enabled": true,
            "Interval": 1000
          }
        },
        {
          "Name": "cfx_work_completed",
          "SensorGroup": "SYS",
          "Parameters": {
            "MessageName": "CFX.Production.WorkCompleted"
          },
          "SensorInfo": {
            "DisplayName": "Work Completed",
            "Description": "Process stage completed",
            "Schema": "application/json"
          },
          "Report": {
            "Enabled": true,
            "Interval": 1000
          }
        },
        {
          "Name": "cfx_units_unloaded",
          "SensorGroup": "SYS",
          "Parameters": {
            "MessageName": "CFX.Production.LoadingAndUnloading.UnitsUnloaded"
          },
          "SensorInfo": {
            "DisplayName": "Units Unloaded",
            "Description": "Units unloaded into a carrier",
            "Schema": "application/json"
          },
          "Report": {
            "Enabled": true,
            "Interval": 1000
          }
        },
        {
          "Name": "cfx_units_departed",
