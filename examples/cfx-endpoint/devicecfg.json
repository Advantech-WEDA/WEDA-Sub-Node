          "Parameters": {
            "MessageName": "CFX.Production.UnitsDeparted"
          },
          "SensorInfo": {
            "DisplayName": "Units Departed",
            "Description": "Units physically departed the endpoint",
            "Schema": "application/json"
          },
          "Report": {
            "Enabled": true,
            "Interval": 1000
          }
        },
        {
          "Name": "cfx_magazine_departed",
          "SensorGroup": "SYS",
          "Parameters": {
            "MessageName": "CFX.Production.Hermes.MagazineDeparted"
          },
          "SensorInfo": {
            "DisplayName": "Magazine Departed",
            "Description": "Hermes magazine departed, with its per-slot unit data",
            "Schema": "application/json"
          },
          "Report": {
            "Enabled": true,
            "Interval": 1000
          }
        },
        {
          "Name": "cfx_endpoint_shutting_down",
          "SensorGroup": "SYS",
          "Parameters": {
            "MessageName": "CFX.EndpointShuttingDown"
          },
          "SensorInfo": {
            "DisplayName": "Endpoint Shutting Down",
            "Description": "Endpoint about to disconnect from the CFX network",
            "Schema": "application/json"
          },
          "Report": {
            "Enabled": true,
            "Interval": 1000
          }
        },
        {
          "Name": "cfx_station_state_changed",
          "SensorGroup": "SYS",
          "Parameters": {
            "MessageName": "CFX.ResourcePerformance.StationStateChanged"
          },
          "SensorInfo": {
            "DisplayName": "Station State Changed",
            "Description": "SEMI E10/E58 production state transition",
            "Schema": "application/json"
          },
          "Report": {
            "Enabled": true,
            "Interval": 1000
          }
        },
        {
          "Name": "cfx_fault_occurred",
          "SensorGroup": "SYS",
          "Parameters": {
            "MessageName": "CFX.ResourcePerformance.FaultOccurred"
          },
          "SensorInfo": {
            "DisplayName": "Fault Occurred",
