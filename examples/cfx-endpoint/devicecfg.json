          "Parameters": {
            "MessageName": "CFX.ResourcePerformance.FaultCleared"
          },
          "SensorInfo": {
            "DisplayName": "Fault Cleared",
            "Description": "Previously raised fault cleared",
            "Schema": "application/json"
          },
          "Report": {
            "Enabled": true,
