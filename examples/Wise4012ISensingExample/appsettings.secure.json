{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "DeviceConfigs": {
    "MySecureISensingDevice": {
      "DeviceName": "SecureWiseDevice4012SE",
      "DeviceType": "adamEthernet",
      "DtdlPath": "dtdl/devicesensors-1.json",
      "DeviceCapabilities": {
        "Manufacturer": "Advantech",
        "Model": "WISE-4012SE",
        "SubNodeSwVersion": "0.0.1",
        "DeviceInfo": {
          "Version": "UserV1",
          "Description": "WISE-4012SE with ISensing Protocol over Secure MQTT (TLS + Authentication)",
          "Location": "172.16.8.122"
        }
      },
      "Communication": {
        "BrokerUrl": "mqtts://172.16.8.122:8883",
        "ClientId": "wise4012-isensing-secure-demo",
        "MacAddress": "00D0C9FAC80E",
        "Manufacturer": "Advantech",
        "Security": {
          "UseTls": true,
          "TlsVersion": "Tls12",
          "Username": "advantech_device",
          "Password": "your-secure-password-here",
          "CaCertificatePath": "/path/to/ca-cert.pem",
          "ClientCertificatePath": "/path/to/client-cert.pfx",
          "ClientCertificatePassword": "cert-password",
          "AllowUntrustedCertificates": false,
          "IgnoreCertificateHostnameValidation": false
        }
      },
      "Sensors": [
        {
          "Name": "AI1",
          "Dtmi": "dtmi:advantech:EdgeSync:AI;1",
          "SensorGroup": "AI",
          "Parameters": {
            "FieldName": "ai1",
            "Description": "Analog Input 1"
          },
          "Config": {
            "Enabled": true,
            "Interval": 1000
          }
        }
      ]
    }
  }
}
