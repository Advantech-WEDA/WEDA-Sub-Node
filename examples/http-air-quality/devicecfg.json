{
  "SubNode": {
    "Name": "AirQualityMonitor",
    "SubNodeType": "CustomDevice",
    "Manufacturer": "MOENV",
    "Model": "AQX-P-136",
    "SwVersion": "1.0.0"
  },
  "SubNodeSettings": {
    "Record": {
      "MinFreeDiskSpaceMb": 128,
      "MaxStorageSizeMb": 1024,
      "RetentionDays": 7
    }
  },
  "DeviceConfigs": {
    "AirQualityConfig": {
      "Enabled": true,
      "Periods": {
        "BatchSend": false
      },
      "Dtdl": {
        "AutoGenEnabled": true
      },
      "Sensors": [
        {
          "Name": "hb",
          "SensorGroup": "SYS",
          "Parameters": {},
          "Report": {
            "Enabled": true,
            "Interval": 60000
          },
          "Record": {
            "Enabled": false
          },
          "SensorInfo": {
            "Schema": "boolean",
            "Description": "Reserved platform liveness ping. Declaring a sensor named 'hb' enables the SubNode heartbeat; it is never polled, its value is synthesized by the SDK, and its dtmi is supplied by the SDK. Schema is always stamped to boolean; it is declared here so the config satisfies the cloud sensorInfo envelope, where schema is required.",
            "DisplayName": "Heartbeat"
          }
        },
        {
          "Name": "taipei_air_quality",
          "SensorGroup": "TEMP",
          "SensorInfo": {
            "DisplayName": "Taipei Air Quality",
            "Description": "Air quality monitoring data from MOENV",
            "Schema": "application/json"
          },
          "Report": {
            "Enabled": true,
            "Interval": 3600000
          },
          "Record": {
            "Enabled": true,
            "Interval": 3600000
          }
        }
      ]
    }
  }
}
