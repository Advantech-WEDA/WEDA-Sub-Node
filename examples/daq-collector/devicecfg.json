{
  "SubNode": {
    "Name": "UniaxialVibrationDevice",
    "SubNodeType": "DaqDevice",
    "Manufacturer": "Advantech",
    "Model": "iDAQ-801+B10BG3",
    "SwVersion": "1.0.0"
  },
  "DeviceConfigs": {
    "UniaxialVibrationDeviceConfig": {
      "Enabled": true,
      "Dtdl": {
        "AutoGenEnabled": true
      },
      "DeviceCommunication": {
        "DaqModuleDeviceNumber": 3
      },
      "Properties": {
        "AcquisitionRateHz": 1000,
        "ObservationWindowSeconds": 1.0
      },
