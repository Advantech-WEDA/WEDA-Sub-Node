{
  "SubNode": {
    "Name": "ImageSensorDemo",
    "SubNodeType": "CustomDevice",
    "Manufacturer": "Advantech",
    "Model": "MNIST-Demo",
    "SwVersion": "1.0.0"
  },
  "SubNodeSettings": {
    "Record": {
      "MinFreeDiskSpaceMb": 128,
      "MaxStorageSizeMb": 1024,
      "RetentionDays": 7
    }
  },
  "DeviceConfigs": {
    "ImageSensorConfig": {
      "Enabled": true,
      "DeviceCommunication": {
        "BrokerUrl": "mqtt://localhost:1883",
        "ClientId": "image-sensor-demo"
      },
      "Dtdl": {
        "AutoGenEnabled": true
      },
      "Sensors": [
        {
          "Name": "hb",
          "SensorGroup": "SYS",
          "Parameters": {},
          "Report": {
            "Enabled": true,
            "Interval": 60000
          },
          "Record": {
            "Enabled": false
          },
          "SensorInfo": {
            "Schema": "boolean",
            "Description": "Reserved platform liveness ping. Declaring a sensor named 'hb' enables the SubNode heartbeat; it is never polled, its value is synthesized by the SDK, and its dtmi is supplied by the SDK. Schema is always stamped to boolean; it is declared here so the config satisfies the cloud sensorInfo envelope, where schema is required.",
            "DisplayName": "Heartbeat"
          }
        },
        {
          "Name": "MnistCamera",
          "SensorGroup": "SYS",
          "Parameters": {
            "Topic": "sensor/image/mnist"
          },
          "SensorInfo": {
            "DisplayName": "MNIST Image Sensor",
            "Description": "Receives MNIST digit images via MQTT",
            "Schema": "image/png"
          },
          "Record": {
            "Enabled": false,
            "Interval": 5000
          },
          "Report": {
            "Enabled": true,
            "Interval": 30000,
            "TransformPipeline": [
              {
                "Type": "chunking",
                "Enabled": true
              }
            ]
          }
        }
      ]
    }
  }
}
