{
  "name": "Weda SubNode SDK",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "DTDL_BASE_PATH": "/workspace"
  },
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
  ],

  // Configure tool-specific properties
  "customizations": {
    "vscode": {
      "extensions": [
        // C# and .NET
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscode-dotnet-runtime",

        // Docker
        "ms-azuretools.vscode-docker",

        // EditorConfig
        "editorconfig.editorconfig",

        // Markdown
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "dotnet.defaultSolution": "Weda.SubNode.sln",
        "omnisharp.enableEditorConfigSupport": true,
        "omnisharp.enableRoslynAnalyzers": true,
        "omnisharp.organizeImportsOnFormat": true,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "files.exclude": {
          "**/bin": true,
          "**/obj": true
        }
      }
    }
  },

  // Features to add to the dev container
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },

  // Post create command to restore packages and install templates
  "postCreateCommand": "bash /tmp/install-templates.sh && dotnet restore && dotnet build",

  // Comment out to run as root instead
  "remoteUser": "vscode",

  // Environment variables
  "remoteEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "NUGET_XMLDOC_MODE": "skip"
  }
}
